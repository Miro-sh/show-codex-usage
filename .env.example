# Optional. The server reads Codex credentials from this local file.
# CODEX_AUTH_FILE=/root/.codex/auth.json

# Optional. Defaults to the Codex usage endpoint.
# USAGE_API_URL=https://chatgpt.com/backend-api/wham/usage

# Optional. Public reset request counter endpoint.
# RESET_REQUESTS_API_URL=https://codex-resets.com/api/reset-requests

# Required. Clients must send this value in the X-API-KEY header.
DASHBOARD_API_KEY=replace-with-a-long-random-key

# Optional. Defaults to all network interfaces.
HOST=0.0.0.0

# Optional. Defaults to 8000.
PORT=8000
